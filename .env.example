# =========================================================
# MyDpix AI — Environment Variables
# Copy this file to .env.local (development) and configure
# the same keys in your hosting provider for production.
# =========================================================

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase ---
# Project Settings > API in your Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server-only, never expose to the client
SUPABASE_SERVICE_ROLE_KEY=

# --- OpenAI ---
# Used for gpt-image-1 generation and the moderation endpoint
OPENAI_API_KEY=

# --- Paystack ---
PAYSTACK_SECRET_KEY=
# Recurring monthly subscription plan codes — created once in the Paystack
# dashboard (Payments > Plans) for each tier, priced in Naira. Coin allotments
# per tier live in src/lib/coins.ts (TIERS), decoupled from billing.
PAYSTACK_PLAN_TIER1=
PAYSTACK_PLAN_TIER2=
PAYSTACK_PLAN_TIER3=
# Coin top-up pricing/amount are admin-configurable via site_settings
# (topup_price_naira, topup_coins_amount) — no separate Paystack plan needed,
# since top-ups are one-off charges, not subscriptions.

# --- Upstash Redis (rate limiting) ---
# Create a free Redis database at upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Optional: OAuth providers ---
# Configure directly in the Supabase Auth dashboard (Providers tab).
# No extra env vars are needed here — Supabase handles the OAuth flow.
