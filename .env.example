# =========================================================
# MyDpix AI — Environment Variables
# Copy this file to .env.local (development) and configure
# the same keys in your hosting provider for production.
# =========================================================

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase ---
# Project Settings > API in your Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server-only, never expose to the client
SUPABASE_SERVICE_ROLE_KEY=

# --- OpenAI ---
# Used for gpt-image-1 generation and the moderation endpoint
OPENAI_API_KEY=

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Recurring monthly subscription prices — one per tier (see src/lib/coins.ts for
# coin allotments/pricing in Naira; these must match what you set up in Stripe)
STRIPE_PRICE_TIER1=
STRIPE_PRICE_TIER2=
STRIPE_PRICE_TIER3=
# One-time payment price for a coin top-up pack (paid tiers only)
STRIPE_PRICE_TOPUP=

# --- Upstash Redis (rate limiting) ---
# Create a free Redis database at upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Optional: OAuth providers ---
# Configure directly in the Supabase Auth dashboard (Providers tab).
# No extra env vars are needed here — Supabase handles the OAuth flow.
