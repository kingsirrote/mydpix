    "openai": "4.56.0",
    "sharp": "0.33.5",
    "zod": "3.23.8",
    "nanoid": "5.0.7",
    "@upstash/redis": "1.34.0",
    "@upstash/ratelimit": "2.0.3",
    "clsx": "2.1.1",
    "tailwind-merge": "2.5.2",
    "framer-motion": "11.5.4",
    "lucide-react": "0.441.0",
    "date-fns": "3.6.0",
    "react-hot-toast": "2.4.1",
    "@radix-ui/react-dialog": "1.1.1",
